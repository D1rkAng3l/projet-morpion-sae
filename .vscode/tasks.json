{
  "tasks": [
    {
      "type": "cppbuild",
      "label": "C/C++: compiler le morpion (Linux)",
      "command": "/usr/bin/gcc",
      "args": [
        "-std=c23",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-pedantic",
        "-fdiagnostics-color=always",
        "-g",
        "${workspaceFolder}/jeu.c",
        "-o",
        "${workspaceFolder}/jeu"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Compilation du morpion dans jeu.c avec GCC."
    }
  ],
  "version": "2.0.0"
}
